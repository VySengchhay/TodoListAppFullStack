# Copy this file to .env and adjust as needed. docker-compose reads .env automatically.

DB_NAME=todoauth
DB_USERNAME=todoauth
DB_PASSWORD=todoauth

# Generate a long random string for production, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-dev-secret-change-this-dev-secret
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=30

OTP_EXPIRY_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5

# --- Email: pick one of the three modes below ---
#
# 1) Local inbox (docker-compose default, no credentials needed).
#    Mail goes to the Mailpit container; read it at http://localhost:8025
MAIL_CONSOLE_MODE=false
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@todoauth.local
#
# 2) No email at all - OTP codes are logged to the backend console:
#      docker logs -f todoauth-backend | grep "DEV MODE"
#    MAIL_CONSOLE_MODE=true
#
# 3) Real SMTP, e.g. Gmail (needs a 16-character App Password, not your
#    normal password; requires 2-Step Verification on the account):
#    MAIL_CONSOLE_MODE=false
#    MAIL_HOST=smtp.gmail.com
#    MAIL_PORT=587
#    MAIL_SMTP_AUTH=true
#    MAIL_SMTP_STARTTLS=true
#    MAIL_USERNAME=you@gmail.com
#    MAIL_PASSWORD=your-app-password
#    MAIL_FROM=you@gmail.com
